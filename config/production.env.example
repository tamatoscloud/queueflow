# QueueFlow — Production environment template (no secrets)
# All CHANGE_ME values must be injected by CI/CD or your secret manager.

APP_ENV=production
PORT=3000
API_BASE_PATH=/api

# Supabase (production project)
DATABASE_URL=CHANGE_ME_INJECTED_BY_CI
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=CHANGE_ME_INJECTED_BY_CI
SUPABASE_SECRET_KEY=CHANGE_ME_INJECTED_BY_CI
SUPABASE_JWKS_URL=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# Upstash Redis (production)
REDIS_URL=CHANGE_ME_INJECTED_BY_CI

JWT_SECRET=CHANGE_ME_INJECTED_BY_CI
REFRESH_TOKEN_SECRET=CHANGE_ME_INJECTED_BY_CI
JWT_EXPIRY_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30

NOTIFICATION_USE_MOCK=false
NOTIFICATION_QUEUE_ENABLED=true
WHATSAPP_ACCESS_TOKEN=CHANGE_ME_INJECTED_BY_CI
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME_INJECTED_BY_CI
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_TEMPLATE_YOUR_TURN=your_turn
WHATSAPP_TEMPLATE_QUEUE_JOINED=queue_joined
SMS_HTTP_GATEWAY_URL=CHANGE_ME_INJECTED_BY_CI

CORS_ALLOWED_ORIGINS=https://queueflow.app,https://portal.queueflow.app,https://admin.queueflow.app
SENTRY_DSN=CHANGE_ME_INJECTED_BY_CI
LOG_LEVEL=warn
GIT_SHA=CHANGE_ME_INJECTED_BY_CI
BUILD_NUMBER=CHANGE_ME_INJECTED_BY_CI

# Latency / health (see docs/LATENCY_BUDGET.md)
BCRYPT_ROUNDS=10
REDIS_HEALTH_PROBE_TIMEOUT_MS=1000
REDIS_HEALTH_CACHE_MS=10000
HEALTH_DEPENDENCY_TIMEOUT_MS=1500

# Customer portal
# NEXT_PUBLIC_API_BASE_URL=https://api.queueflow.app/api/v1
# NEXT_PUBLIC_WS_BASE_URL=https://api.queueflow.app
# NEXT_PUBLIC_SENTRY_DSN=CHANGE_ME_INJECTED_BY_CI

# Flutter web apps
# API_BASE_URL=https://api.queueflow.app/api/v1
# WS_BASE_URL=https://api.queueflow.app
# SENTRY_DSN=CHANGE_ME_INJECTED_BY_CI

# Never set SEED_DEMO_PASSWORD in production.
