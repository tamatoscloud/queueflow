# QueueFlow — Development environment template
# Copy secrets to backend/.env.local and per-app .env.local as needed.
# No real secrets in this file.

# ── Backend (backend/.env.development + backend/.env.local) ──
APP_ENV=development
PORT=3000
API_BASE_PATH=/api
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=CHANGE_ME
SUPABASE_SECRET_KEY=CHANGE_ME
SUPABASE_JWKS_URL=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
REDIS_URL=rediss://default:YOUR_UPSTASH_TOKEN@YOUR_ENDPOINT.upstash.io:6379
JWT_SECRET=CHANGE_ME_MIN_32_CHARS
REFRESH_TOKEN_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_EXPIRY_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30
NOTIFICATION_USE_MOCK=true
NOTIFICATION_QUEUE_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173
SENTRY_DSN=
LOG_LEVEL=debug
GIT_SHA=local
BUILD_NUMBER=local

# Seed (development only — never use in production)
# SEED_DEMO_PASSWORD=your-local-only-password

# ── Customer Portal (apps/customer-portal/.env.local) ──
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
# NEXT_PUBLIC_WS_BASE_URL=http://localhost:3000
# NEXT_PUBLIC_SENTRY_DSN=

# ── Flutter apps (.env.dev in each app) ──
# API_BASE_URL=http://localhost:3000/api/v1
# WS_BASE_URL=http://localhost:3000
# APP_NAME=QueueFlow
# SENTRY_DSN=
