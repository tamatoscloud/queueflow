# QueueFlow — Staging environment template (no secrets)
# Inject real values via your deployment platform (GitHub Actions secrets, Vercel, etc.)

APP_ENV=staging
PORT=3000
API_BASE_PATH=/api

# Supabase (staging project)
DATABASE_URL=CHANGE_ME_INJECTED_BY_CI
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=CHANGE_ME_INJECTED_BY_CI
SUPABASE_SECRET_KEY=CHANGE_ME_INJECTED_BY_CI
SUPABASE_JWKS_URL=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# Upstash Redis (staging)
REDIS_URL=CHANGE_ME_INJECTED_BY_CI

JWT_SECRET=CHANGE_ME_INJECTED_BY_CI
REFRESH_TOKEN_SECRET=CHANGE_ME_INJECTED_BY_CI
JWT_EXPIRY_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30

NOTIFICATION_USE_MOCK=false
NOTIFICATION_QUEUE_ENABLED=true
CORS_ALLOWED_ORIGINS=https://staging.queueflow.app,https://portal.staging.queueflow.app
SENTRY_DSN=CHANGE_ME_INJECTED_BY_CI
LOG_LEVEL=info
GIT_SHA=CHANGE_ME_INJECTED_BY_CI
BUILD_NUMBER=CHANGE_ME_INJECTED_BY_CI

# Customer portal
# NEXT_PUBLIC_API_BASE_URL=https://api.staging.queueflow.app/api/v1
# NEXT_PUBLIC_WS_BASE_URL=https://api.staging.queueflow.app
# NEXT_PUBLIC_SENTRY_DSN=CHANGE_ME_INJECTED_BY_CI

# Flutter web apps
# API_BASE_URL=https://api.staging.queueflow.app/api/v1
# WS_BASE_URL=https://api.staging.queueflow.app
# SENTRY_DSN=CHANGE_ME_INJECTED_BY_CI
