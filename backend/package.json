{
  "name": "@queueflow/backend",
  "version": "0.1.0",
  "private": true,
  "description": "QueueFlow backend — NestJS application layer + Prisma + Queue Engine.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "dotenv -c development -- nest start --watch",
    "start:dev": "npm run dev",
    "start:staging": "dotenv -c staging -- node dist/main.js",
    "start:prod": "dotenv -c production -- node dist/main.js",
    "prisma:generate": "dotenv -c development -- node scripts/prisma-with-preflight.mjs generate",
    "prisma:migrate:dev": "dotenv -c development -- node scripts/prisma-with-preflight.mjs migrate dev",
    "prisma:migrate:deploy": "dotenv -c development -- node scripts/prisma-with-preflight.mjs migrate deploy",
    "prisma:migrate:deploy:prod": "dotenv -c production -- node scripts/prisma-with-preflight.mjs migrate deploy",
    "prisma:migrate:status": "dotenv -c development -- node scripts/prisma-with-preflight.mjs migrate status",
    "prisma:studio": "dotenv -c development -- node scripts/prisma-with-preflight.mjs studio",
    "prisma:seed": "dotenv -c development -- node scripts/prisma-with-preflight.mjs db seed",
    "prisma:reset": "dotenv -c development -- node scripts/prisma-with-preflight.mjs migrate reset",
    "db:seed": "npm run prisma:seed",
    "db:reset": "npm run prisma:reset",
    "demo:reset": "dotenv -c development -- npx ts-node --transpile-only scripts/demo-reset.ts reset",
    "demo:clear": "dotenv -c development -- npx ts-node --transpile-only scripts/demo-reset.ts clear",
    "demo:provision-passwords": "npx ts-node --transpile-only scripts/provision-demo-passwords.ts",
    "db:check": "dotenv -c development -- node scripts/check-database-url.mjs && dotenv -c development -- npx ts-node --transpile-only scripts/test-db-connection.ts",
    "validate:env": "dotenv -c development -- npx ts-node --transpile-only scripts/validate-env.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --dir src --exclude '**/integration/**'",
    "test:integration": "vitest run src/**/integration/**",
    "test:pg-queue-integration": "vitest run src/infrastructure/notifications/integration/notification-job.postgres.integration.test.ts",
    "probe:pg-queue-staging": "node scripts/pg-queue-staging-probe.mjs",
    "worker:notifications": "dotenv -c development -- node dist/infrastructure/notifications/worker/notification-worker.bootstrap.js"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.28",
    "@prisma/client": "^6.1.0",
    "@sentry/nestjs": "^10.68.0",
    "@sentry/node": "^10.68.0",
    "@supabase/server": "^1.4.0",
    "@supabase/supabase-js": "^2.110.8",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.34.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "uuid": "^11.0.3",
    "ws": "~8.21.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.3.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/helmet": "^0.0.48",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.1.0",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
