# QueueFlow backend — environment template
# ─────────────────────────────────────────────────────────────────────────────
# Local setup:
#   1. Copy this file to .env.local (gitignored)
#   2. Fill in real secrets (DATABASE_URL, Supabase keys, JWT secrets, …)
#   3. Run the app via npm scripts only (never raw npx prisma)
#
# npm run dev loads:  .env.development + .env.local
# npm run start:prod: .env.production (+ CI-injected secrets)
# ─────────────────────────────────────────────────────────────────────────────

APP_ENV=development
PORT=3000
API_BASE_PATH=/api

# Required — PostgreSQL connection string (Prisma). Never commit real values.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase (if used)
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=CHANGE_ME
SUPABASE_SECRET_KEY=CHANGE_ME
SUPABASE_JWKS_URL=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# Redis — managed instance (Upstash TLS: rediss://)
REDIS_URL=rediss://default:YOUR_UPSTASH_TOKEN@YOUR_ENDPOINT.upstash.io:6379

# Auth
JWT_SECRET=CHANGE_ME
JWT_EXPIRY_SECONDS=3600
REFRESH_TOKEN_SECRET=CHANGE_ME

# Optional
FIREBASE_PROJECT_ID=queueflow-dev
SENTRY_DSN=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173
LOG_LEVEL=debug
NOTIFICATION_USE_MOCK=true
