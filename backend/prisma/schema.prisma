// QueueFlow — Database Layer
//
// Design decisions are explained in full at docs/DATABASE_DESIGN.md and the
// ER diagram at docs/ERD.md. This file is intentionally heavily commented
// inline as well, since a schema this size is easiest to review in place.
//
// Conventions used throughout (see docs/DATABASE_DESIGN.md for rationale):
//   - UUID primary keys (`id`), generated by Prisma (client-side uuid v4).
//   - snake_case column/table names in Postgres via @map/@@map; camelCase in
//     the generated Prisma Client.
//   - createdAt/updatedAt/deletedAt + createdBy/updatedBy on every table
//     that represents mutable, tenant-owned data. Explicit exceptions:
//     immutable append-only logs (AuditLog, NotificationLog) have no
//     updatedAt/updatedBy/deletedAt, and pure join tables (RolePermission,
//     UserRole, UserBranch) have only createdAt.
//   - createdBy/updatedBy are plain nullable UUID columns, NOT enforced FK
//     relations to User — see docs/DATABASE_DESIGN.md "Why createdBy/
//     updatedBy are not relations".
//   - Every tenant-owned table carries `businessId` directly (even when
//     reachable via a join), to support Postgres Row-Level Security — see
//     migration 20260717131500_partial_unique_indexes_and_rls and
//     docs/DATABASE_DESIGN.md.
//   - Soft-delete uniqueness (e.g. Business.slug) is enforced via partial
//     unique indexes added in a follow-up raw-SQL migration, not the
//     `@@unique` you see in this file for those specific fields — Prisma's
//     schema DSL has no native `WHERE` clause for indexes yet. Search
//     docs/DATABASE_DESIGN.md for "partial unique index" for the full list.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Used by migrate/introspect. Prefer a session-mode or direct Postgres URL.
  // Runtime Prisma Client uses `url` — interactive transactions require session
  // mode (pooler :5432) or a direct connection; transaction-mode :6543 is unsafe.
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum BusinessStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED

  @@map("business_status")
}

enum BranchStatus {
  ACTIVE
  INACTIVE

  @@map("branch_status")
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@map("user_status")
}

/// Weekday used by WorkingHours. Modeled as an enum (rather than an int)
/// so seed data / queries read unambiguously.
enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY

  @@map("weekday")
}

enum QueueStatus {
  ACTIVE
  PAUSED
  CLOSED
  ARCHIVED

  @@map("queue_status")
}

enum QueueTokenStatus {
  ISSUED
  VOID

  @@map("queue_token_status")
}

/// Requirement #3 — the full QueueEntry lifecycle.
enum QueueEntryStatus {
  WAITING
  CALLED
  HOLDING
  SKIPPED
  COMPLETED
  CANCELLED
  NO_SHOW

  @@map("queue_entry_status")
}

/// How a QueueEntry was created — matters for analytics (QR conversion
/// rate vs. staff-assisted walk-ins) and for access control (only staff
/// can create STAFF_MANUAL/WALK_IN entries).
enum QueueEntrySource {
  QR_LANDING
  STAFF_MANUAL
  WALK_IN

  @@map("queue_entry_source")
}

/// The customer's chosen notification preference at join time (requirement
/// #4's "WhatsApp / SMS / Both" step). Deliberately distinct from
/// NotificationChannel: BOTH is not a wire channel, it's a preference that
/// fans out into two Notification rows (one per channel) when messages are
/// actually sent.
enum NotificationPreference {
  WHATSAPP
  SMS
  BOTH

  @@map("notification_preference")
}

/// The actual wire channel for one Notification. EMAIL is included now
/// (per requirement #5, "future") even though no app collects an email
/// today, so the enum doesn't need a breaking migration later.
enum NotificationChannel {
  WHATSAPP
  SMS
  EMAIL

  @@map("notification_channel")
}

enum NotificationType {
  QUEUE_JOINED
  POSITION_UPDATE
  ALMOST_YOUR_TURN
  YOUR_TURN
  QUEUE_CANCELLED
  QUEUE_PAUSED
  QUEUE_RESUMED
  QUEUE_CLOSED
  FEEDBACK_REQUEST
  CUSTOM

  @@map("notification_type")
}

/// High-level status of a Notification, denormalized from its latest
/// NotificationLog entry so list/dashboard queries don't need to join.
enum NotificationStatus {
  PENDING
  QUEUED
  PROCESSING
  SENT
  DELIVERED
  FAILED
  CANCELLED

  @@map("notification_status")
}

/// Outbox / worker queue for PostgreSQL-backed notification delivery
/// (alternative to BullMQ/Redis). One row per notification intent.
enum NotificationJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  DEAD

  @@map("notification_job_status")
}

/// Per-attempt delivery status, one row per NotificationLog. A Notification
/// can have several NotificationLog rows (retries, provider webhook
/// updates progressing SENT -> DELIVERED -> READ).
enum NotificationLogStatus {
  SENT
  DELIVERED
  FAILED
  BOUNCED
  READ

  @@map("notification_log_status")
}

enum NotificationProvider {
  TWILIO
  META_CLOUD_API
  GUPSHUP
  MSG91
  OTHER

  @@map("notification_provider")
}

enum FeedbackStatus {
  REQUESTED
  SUBMITTED
  SKIPPED
  EXPIRED

  @@map("feedback_status")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED

  @@map("subscription_status")
}

enum BillingCycle {
  MONTHLY
  YEARLY

  @@map("billing_cycle")
}

enum StaffInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED

  @@map("staff_invitation_status")
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB

  @@map("device_platform")
}

enum AuthTokenType {
  PASSWORD_RESET
  EMAIL_VERIFICATION

  @@map("auth_token_type")
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED

  @@map("support_ticket_status")
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("support_ticket_priority")
}

/// Vertical classification for restaurant operating platform features.
enum BusinessType {
  RESTAURANT
  CAFE
  FOOD_COURT
  CLOUD_KITCHEN
  GENERIC

  @@map("business_type")
}

/// Service modes a restaurant can enable (one or more).
enum ServiceMode {
  DINE_IN
  TAKEAWAY
  DRIVE_IN

  @@map("service_mode")
}

enum QRCodePurpose {
  ENTRANCE
  TAKEAWAY_RECEIPT
  DRIVE_IN_ENTRANCE
  WAITER_PERSONAL
  KITCHEN
  RECEPTION
  QUEUE

  @@map("qr_code_purpose")
}

enum RestaurantTableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING

  @@map("restaurant_table_status")
}

enum WaiterShiftStatus {
  AVAILABLE
  SERVING
  BREAK
  OFFLINE

  @@map("waiter_shift_status")
}

enum KitchenOrderStage {
  INCOMING
  PREPARING
  READY
  DELAYED
  COLLECTED

  @@map("kitchen_order_stage")
}

// =============================================================================
// TENANT ROOT
// =============================================================================

/// The tenant. Every business-owned row ultimately traces back here —
/// directly, per the businessId-everywhere convention (see file header).
model Business {
  id       String         @id @default(uuid()) @db.Uuid
  name     String
  /// URL-safe identifier, e.g. for a future public booking path.
  /// Uniqueness enforced via partial unique index (see file header).
  slug     String
  email    String
  phone    String?
  logoUrl  String?        @map("logo_url")
  status   BusinessStatus @default(TRIAL)
  businessType BusinessType @default(RESTAURANT) @map("business_type")
  /// IANA timezone, e.g. "Asia/Karachi". Branches may override.
  timezone String         @default("UTC")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  branches         Branch[]
  users            User[]
  roles            Role[]
  staffInvitations StaffInvitation[]
  queues           Queue[]
  customers        Customer[]
  qrCodes          QRCode[]
  notifications    Notification[]
  notificationTemplates NotificationTemplate[]
  feedback         Feedback[]
  subscriptions    Subscription[]
  auditLogs        AuditLog[]
  holidays         Holiday[]
  settings         BusinessSettings?
  queueEntries     QueueEntry[]
  supportTickets   SupportTicket[]
  restaurantTables RestaurantTable[]
  waiterProfiles   WaiterProfile[]
  kitchenOrders    KitchenOrder[]
  webPushSubscriptions WebPushSubscription[]

  @@map("businesses")
}

/// 1:1 tenant-wide configuration. Split from Business so the
/// frequently-read Business row stays narrow, and because these are
/// logically "settings" not "identity" — different change frequency and
/// access pattern (config UI writes this a lot more than Business itself).
model BusinessSettings {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @unique @map("business_id") @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  defaultNotificationChannel NotificationPreference @default(SMS) @map("default_notification_channel")
  allowWalkIns               Boolean                @default(true) @map("allow_walk_ins")
  requireGuestCount          Boolean                @default(true) @map("require_guest_count")
  maxGuestsPerEntry          Int                    @default(10) @map("max_guests_per_entry")
  feedbackEnabled            Boolean                @default(true) @map("feedback_enabled")
  feedbackDelaySeconds       Int                    @default(60) @map("feedback_delay_seconds")
  brandColor                 String?                @map("brand_color")
  brandLogoUrl               String?                @map("brand_logo_url")
  customDomain               String?                @map("custom_domain")
  locale                     String                 @default("en")
  smsSenderId                String?                @map("sms_sender_id")
  whatsappBusinessNumber     String?                @map("whatsapp_business_number")
  notificationsEnabled       Boolean                @default(true) @map("notifications_enabled")
  positionUpdateIntervalSec  Int                    @default(120) @map("position_update_interval_sec")
  almostYourTurnPosition     Int                    @default(3) @map("almost_your_turn_position")
  /// Days to retain PII (Customer/QueueEntry/Notification content) before a
  /// scheduled purge job anonymizes it. Compliance hook, not enforced by
  /// the DB itself.
  dataRetentionDays          Int                    @default(365) @map("data_retention_days")
  /// Per-tenant feature overrides (platform admin).
  featureFlags               Json                   @default("{}") @map("feature_flags")
  /// Enabled service modes for this tenant (Dine-In, Takeaway, Drive-In).
  enabledModes               ServiceMode[]          @default([DINE_IN]) @map("enabled_modes")
  /// Guest-facing restaurant menu shown on the customer waiting screen.
  /// Shape: { categories: [{ id, name, items: [{ id, name, description?, price, tags?, available? }] }] }
  guestMenu                  Json?                  @map("guest_menu")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@map("business_settings")
}

// =============================================================================
// BRANCHES
// =============================================================================

model Branch {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name      String
  /// Short code unique per business, e.g. "DHA", "GULBERG-2". Uniqueness
  /// enforced via partial unique index (see file header).
  code      String
  address   String?
  city      String?
  country   String?
  /// Overrides Business.timezone when set.
  timezone  String?
  phone     String?
  email     String?
  latitude  Decimal?     @db.Decimal(9, 6)
  longitude Decimal?     @db.Decimal(9, 6)
  status    BranchStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  queues           Queue[]
  qrCodes          QRCode[]
  restaurantTables RestaurantTable[]
  waiterProfiles   WaiterProfile[]
  kitchenOrders    KitchenOrder[]
  workingHours     WorkingHours[]
  holidays         Holiday[]
  userBranches     UserBranch[]
  settings         BranchSettings?
  feedback         Feedback[]
  queueEntries     QueueEntry[]
  staffInvitations StaffInvitation[]

  @@index([businessId])
  @@index([businessId, status])
  @@map("branches")
}

/// 1:1 branch-level overrides of BusinessSettings. Only the fields that
/// plausibly vary per-branch are here — everything else falls back to
/// BusinessSettings at the application layer.
model BranchSettings {
  id       String @id @default(uuid()) @db.Uuid
  branchId String @unique @map("branch_id") @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  maxQueueCapacity     Int?    @map("max_queue_capacity")
  autoAcceptEntries    Boolean @default(true) @map("auto_accept_entries")
  /// Whether the public QR landing page can add entries to this branch's
  /// queues, or whether joining is staff-only (manual/walk-in).
  allowRemoteJoin      Boolean @default(true) @map("allow_remote_join")
  checkInBufferMinutes Int     @default(5) @map("check_in_buffer_minutes")
  timezone             String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@map("branch_settings")
}

model WorkingHours {
  id       String @id @default(uuid()) @db.Uuid
  branchId String @map("branch_id") @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  dayOfWeek Weekday  @map("day_of_week")
  /// Stored as time-of-day; multiple rows per (branchId, dayOfWeek) are
  /// allowed deliberately, to support split shifts (e.g. lunch break).
  openTime  DateTime @map("open_time") @db.Time()
  closeTime DateTime @map("close_time") @db.Time()
  isClosed  Boolean  @default(false) @map("is_closed")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  @@index([branchId, dayOfWeek])
  @@map("working_hours")
}

/// Scoped to Business with an optional branchId override: a NULL branchId
/// means "applies to every branch of this business" (e.g. a national
/// public holiday); a non-NULL branchId overrides just that branch.
model Holiday {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId   String?  @map("branch_id") @db.Uuid
  branch     Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  date      DateTime  @db.Date
  name      String
  /// Fully closed if true; if false, openTime/closeTime describe special
  /// reduced hours for that date instead.
  isClosed  Boolean   @default(true) @map("is_closed")
  openTime  DateTime? @map("open_time") @db.Time()
  closeTime DateTime? @map("close_time") @db.Time()
  /// Yearly-recurring holidays (e.g. public holidays) vs one-off closures.
  recurring Boolean   @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@index([businessId, date])
  @@index([branchId, date])
  @@map("holidays")
}

// =============================================================================
// STAFF, ROLES & PERMISSIONS
// =============================================================================

/// Staff/admin accounts only — there is no customer login (see
/// docs/DATABASE_DESIGN.md "Why there's no Customer auth"). `businessId`
/// is nullable: NULL means a QueueFlow platform-level account (used by
/// admin_panel to manage every tenant), non-NULL means a business's own
/// staff member.
model User {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String?   @map("business_id") @db.Uuid
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  email           String
  phone           String?
  passwordHash    String     @map("password_hash")
  fullName        String     @map("full_name")
  avatarUrl       String?    @map("avatar_url")
  status          UserStatus @default(INVITED)
  lastLoginAt     DateTime?  @map("last_login_at")
  emailVerifiedAt DateTime?  @map("email_verified_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  userRoles          UserRole[]
  userBranches       UserBranch[]
  deviceSessions     DeviceSession[]
  authTokens         AuthToken[]
  sentInvitations    StaffInvitation[] @relation("InvitedByUser")
  acceptedInvitation StaffInvitation[] @relation("AcceptedByUser")
  calledQueueEntries QueueEntry[]      @relation("CalledByUser")
  servedQueueEntries QueueEntry[]      @relation("ServedByUser")
  auditLogs          AuditLog[]
  assignedTickets    SupportTicket[]   @relation("AssignedSupportTickets")
  createdTickets     SupportTicket[]   @relation("CreatedSupportTickets")
  waiterProfile      WaiterProfile?
  assignedQrCodes    QRCode[]          @relation("QRAssignedUser")

  @@index([businessId])
  @@map("users")
}

/// A Role is either a system role (businessId NULL — OWNER, MANAGER,
/// STAFF, VIEWER, PLATFORM_ADMIN, shipped by QueueFlow and available to
/// every tenant) or a custom role a specific business defines for itself.
model Role {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String?   @map("business_id") @db.Uuid
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name        String
  description String?
  isSystem    Boolean @default(false) @map("is_system")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  rolePermissions  RolePermission[]
  userRoles        UserRole[]
  staffInvitations StaffInvitation[]

  // NOTE: uniqueness of (businessId, name) for custom roles, and of (name)
  // among system roles (businessId IS NULL), is enforced via partial
  // unique indexes — see file header and docs/DATABASE_DESIGN.md.
  @@index([businessId])
  @@map("roles")
}

/// Global permission catalog — not tenant-scoped. `key` is the string
/// checked at the API layer, e.g. "queue:create", "branch:manage".
model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique
  description String?
  /// Grouping for a future permissions-management UI, e.g. "QUEUE",
  /// "STAFF", "BILLING".
  category    String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@index([category])
  @@map("permissions")
}

/// Pure join table: Role <-> Permission. No soft delete — removing a
/// permission from a role is a hard delete of the link row.
model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id") @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Pure join table: User <-> Role. `businessId` is denormalized from the
/// Role/User at assignment time purely to make "list all StaffX in
/// BusinessY with RoleZ" a single-table filter — it is not a source of
/// truth and must match the parent Role's businessId at the app layer.
model UserRole {
  userId     String  @map("user_id") @db.Uuid
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId     String  @map("role_id") @db.Uuid
  role       Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  businessId String? @map("business_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  @@id([userId, roleId])
  @@index([businessId])
  @@map("user_roles")
}

/// Pure join table: which branches a staff User can operate in. A user
/// with no rows here but a non-null businessId is a business-wide staff
/// member (e.g. an OWNER who sees every branch) — enforced at the app
/// layer via the Role's permissions, not by this table's absence/presence.
model UserBranch {
  userId    String  @map("user_id") @db.Uuid
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId  String  @map("branch_id") @db.Uuid
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  isPrimary Boolean @default(false) @map("is_primary")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  @@id([userId, branchId])
  @@map("user_branches")
}

model StaffInvitation {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId   String?  @map("branch_id") @db.Uuid
  branch     Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  roleId     String   @map("role_id") @db.Uuid
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  email      String
  /// Opaque, unguessable invite-link token. Unique globally.
  token      String                @unique
  status     StaffInvitationStatus @default(PENDING)
  expiresAt  DateTime              @map("expires_at")
  acceptedAt DateTime?             @map("accepted_at")

  invitedByUserId  String? @map("invited_by_user_id") @db.Uuid
  invitedByUser    User?   @relation("InvitedByUser", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  acceptedByUserId String? @map("accepted_by_user_id") @db.Uuid
  acceptedByUser   User?   @relation("AcceptedByUser", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@index([businessId, status])
  @@index([email])
  @@map("staff_invitations")
}

/// Staff/admin login sessions — one row per device/browser. Also the
/// natural home for a device's FCM push token (bridging to
/// `queueflow_services`' NotificationService on the Flutter side for
/// business_app/admin_panel).
model DeviceSession {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceId         String         @map("device_id")
  deviceName       String?        @map("device_name")
  platform         DevicePlatform
  pushToken        String?        @map("push_token")
  /// Hash of the current refresh token, never the raw token.
  refreshTokenHash String         @map("refresh_token_hash")
  ipAddress        String?        @map("ip_address")
  userAgent        String?        @map("user_agent")
  lastActiveAt     DateTime       @default(now()) @map("last_active_at")
  expiresAt        DateTime       @map("expires_at")
  revokedAt        DateTime?      @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, deviceId])
  @@index([pushToken])
  @@map("device_sessions")
}

/// One-time tokens for password reset and email verification.
model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash")
  expiresAt DateTime      @map("expires_at")
  usedAt    DateTime?     @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, type])
  @@map("auth_tokens")
}

// =============================================================================
// QUEUES
// =============================================================================

model Queue {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId   String   @map("branch_id") @db.Uuid
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name                      String
  description               String?
  status                    QueueStatus @default(ACTIVE)
  /// Short prefix shown on tokens, e.g. "A" -> "A-023".
  prefix                    String      @default("A")
  maxCapacity               Int?        @map("max_capacity")
  /// Rolling average, in minutes, updated as entries complete — the input
  /// to ETA calculation. Maintained by the application layer, not a DB
  /// trigger, so the averaging algorithm can evolve without a migration.
  averageServiceTimeMinutes Int         @default(10) @map("average_service_time_minutes")
  isAcceptingEntries        Boolean     @default(true) @map("is_accepting_entries")
  autoCallNext              Boolean     @default(false) @map("auto_call_next")
  /// When true, call-next / ordering prefer higher `QueueEntry.priority`
  /// (and VIP) before FIFO by `sortOrder`. See docs/QUEUE_ENGINE.md.
  priorityEnabled           Boolean     @default(false) @map("priority_enabled")
  /// Seconds a CALLED customer has to present before recall / no-show
  /// policies may fire. Enforced by the Queue Engine, not the DB.
  recallTimeoutSeconds      Int         @default(120) @map("recall_timeout_seconds")
  /// Seconds after calledAt before an automatic NO_SHOW is allowed.
  noShowTimeoutSeconds      Int         @default(120) @map("no_show_timeout_seconds")
  /// Notify a customer when this many people remain ahead of them.
  notifyBeforeTurns         Int         @default(3) @map("notify_before_turns")
  /// Which restaurant service mode this queue serves.
  serviceMode               ServiceMode @default(DINE_IN) @map("service_mode")

  /// Atomic per-queue token counter. Incremented via a single
  /// `UPDATE ... SET last_token_number = last_token_number + 1 RETURNING`
  /// statement at the application layer — see docs/DATABASE_DESIGN.md
  /// "Token issuance concurrency" for why this is safe without a
  /// SELECT ... FOR UPDATE.
  lastTokenNumber  Int       @default(0) @map("last_token_number")
  lastTokenResetAt DateTime? @map("last_token_reset_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  entries QueueEntry[]
  tokens  QueueToken[]
  qrCodes QRCode[]
  kitchenOrders KitchenOrder[]

  @@index([businessId])
  @@index([branchId, status])
  @@map("queues")
}

/// The atomic sequence + human-facing display code, decoupled from the
/// mutable QueueEntry row it belongs to (see docs/DATABASE_DESIGN.md
/// "Why QueueToken is a separate table from QueueEntry").
model QueueToken {
  id      String @id @default(uuid()) @db.Uuid
  queueId String @map("queue_id") @db.Uuid
  queue   Queue  @relation(fields: [queueId], references: [id], onDelete: Cascade)

  tokenNumber Int              @map("token_number")
  /// e.g. "A-023" — prefix + zero-padded tokenNumber, computed at issuance.
  displayCode String           @map("display_code")
  /// Scopes tokenNumber to a calendar day so numbering restarts daily.
  issuedDate  DateTime         @map("issued_date") @db.Date
  status      QueueTokenStatus @default(ISSUED)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  entry QueueEntry?

  @@unique([queueId, issuedDate, tokenNumber])
  @@index([queueId, issuedDate])
  @@map("queue_tokens")
}

/// The customer's actual place in line. See requirement #3 for the status
/// lifecycle and docs/DATABASE_DESIGN.md for the full state machine
/// (valid transitions, who can trigger each one).
model QueueEntry {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  /// Denormalized from Queue for tenant-scoped queries without a join —
  /// see file header "businessId-everywhere".
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId   String   @map("branch_id") @db.Uuid
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  queueId    String   @map("queue_id") @db.Uuid
  queue      Queue    @relation(fields: [queueId], references: [id], onDelete: Cascade)
  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  queueTokenId String     @unique @map("queue_token_id") @db.Uuid
  queueToken   QueueToken @relation(fields: [queueTokenId], references: [id], onDelete: Restrict)

  status                 QueueEntryStatus       @default(WAITING)
  source                 QueueEntrySource       @default(QR_LANDING)
  partySize              Int                    @default(1) @map("party_size")
  notes                  String?
  /// Mode-specific payload: vehicle plate, order number, table id, etc.
  metadata               Json                   @default("{}") @map("metadata")
  notificationPreference NotificationPreference @default(SMS) @map("notification_preference")
  /// Higher value = served sooner when Queue.priorityEnabled. VIP joins
  /// typically use a elevated priority (see Queue Engine PriorityPolicy).
  priority               Int                    @default(0)
  isVip                  Boolean                @default(false) @map("is_vip")
  /// Manual reorder / FIFO position key. New joins append at max+1;
  /// reorder inserts between neighbors (fractional midpoints). See
  /// docs/QUEUE_ENGINE.md "Ordering".
  sortOrder              Float                  @default(0) @map("sort_order")

  /// Cached position snapshot for fast reads on the live tracking page;
  /// the source of truth is still a live COUNT query by the API layer —
  /// see docs/DATABASE_DESIGN.md "Real-time position & ETA".
  lastKnownPosition    Int? @map("last_known_position")
  estimatedWaitMinutes Float? @map("estimated_wait_minutes")
  /// Populated at COMPLETED, for reporting/analytics on real vs. estimated
  /// wait time.
  actualWaitMinutes    Int? @map("actual_wait_minutes")

  joinedAt         DateTime  @default(now()) @map("joined_at")
  calledAt         DateTime? @map("called_at")
  holdingStartedAt DateTime? @map("holding_started_at")
  skippedAt        DateTime? @map("skipped_at")
  recalledAt       DateTime? @map("recalled_at")
  servedAt         DateTime? @map("served_at")
  cancelledAt      DateTime? @map("cancelled_at")
  noShowAt         DateTime? @map("no_show_at")

  calledByUserId String? @map("called_by_user_id") @db.Uuid
  calledByUser   User?   @relation("CalledByUser", fields: [calledByUserId], references: [id], onDelete: SetNull)
  servedByUserId String? @map("served_by_user_id") @db.Uuid
  servedByUser   User?   @relation("ServedByUser", fields: [servedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  notifications Notification[]
  feedback      Feedback?
  kitchenOrder  KitchenOrder?
  tableAssignments RestaurantTable[] @relation("TableCurrentEntry")

  // "Next in line" / live-tracking read pattern (ordering uses sortOrder):
  @@index([queueId, status, sortOrder])
  @@index([queueId, status, joinedAt])
  // Branch-scoped dashboards & reporting:
  @@index([branchId, status])
  @@index([businessId, createdAt])
  // Customer history:
  @@index([customerId])
  @@map("queue_entries")
}

// =============================================================================
// QR CODES
// =============================================================================

/// A QR code scanned at a branch. `queueId` NULL means the code lands on a
/// branch-level chooser page (pick from active queues); non-NULL means it
/// deep-links straight into one queue.
model QRCode {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId   String   @map("branch_id") @db.Uuid
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  queueId    String?  @map("queue_id") @db.Uuid
  queue      Queue?   @relation(fields: [queueId], references: [id], onDelete: SetNull)

  /// Short unique slug embedded in the landing page URL, e.g. "qf/8xJ2kQ".
  code          String        @unique
  purpose       QRCodePurpose @default(QUEUE) @map("purpose")
  label         String?
  targetUrl     String        @map("target_url")
  imageUrl      String?       @map("image_url")
  isActive      Boolean       @default(true) @map("is_active")
  /// For WAITER_PERSONAL QR codes — links scans to this staff member.
  assignedUserId String?      @map("assigned_user_id") @db.Uuid
  assignedUser   User?         @relation("QRAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  /// Denormalized counter for quick "most-scanned QR" dashboards; the
  /// authoritative event stream, if ever needed, would be a separate
  /// analytics table — out of scope for this schema.
  scansCount    Int       @default(0) @map("scans_count")
  lastScannedAt DateTime? @map("last_scanned_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  @@index([businessId])
  @@index([branchId])
  @@index([assignedUserId])
  @@map("qr_codes")
}

// =============================================================================
// RESTAURANT OPERATIONS — Tables, Waiters, Kitchen
// =============================================================================

/// Floor table for dine-in seating and occupancy tracking.
model RestaurantTable {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId   String   @map("branch_id") @db.Uuid
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name       String
  capacity   Int                  @default(4)
  status     RestaurantTableStatus @default(AVAILABLE)
  /// Floor plan coordinates (0–100 normalized) for drag-drop layout UI.
  posX       Float                @default(0) @map("pos_x")
  posY       Float                @default(0) @map("pos_y")
  section    String?
  /// When merged, points to the primary table id.
  mergedIntoId String?            @map("merged_into_id") @db.Uuid
  mergedInto   RestaurantTable?   @relation("TableMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedTables RestaurantTable[]  @relation("TableMerge")
  currentEntryId String?          @map("current_entry_id") @db.Uuid
  currentEntry   QueueEntry?      @relation("TableCurrentEntry", fields: [currentEntryId], references: [id], onDelete: SetNull)
  assignedWaiterId String?        @map("assigned_waiter_id") @db.Uuid
  assignedWaiter   WaiterProfile? @relation(fields: [assignedWaiterId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  @@index([businessId, branchId, status])
  @@map("restaurant_tables")
}

/// Waiter shift state for drive-in and dine-in assignment.
model WaiterProfile {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId   String   @map("branch_id") @db.Uuid
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  userId     String   @unique @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName    String            @map("display_name")
  status         WaiterShiftStatus @default(OFFLINE)
  currentTableId String?           @map("current_table_id") @db.Uuid
  /// Drive-in: vehicle or lane identifier currently being served.
  currentVehicle String?           @map("current_vehicle")
  ordersServedToday Int             @default(0) @map("orders_served_today")
  avgServiceMinutes Int?            @map("avg_service_minutes")
  personalQrCodeId  String?         @map("personal_qr_code_id") @db.Uuid

  tables RestaurantTable[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([businessId, branchId, status])
  @@map("waiter_profiles")
}

/// Kitchen order tracking for takeaway / drive-in (links to queue entry).
model KitchenOrder {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId   String   @map("branch_id") @db.Uuid
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  queueId    String   @map("queue_id") @db.Uuid
  queue      Queue    @relation(fields: [queueId], references: [id], onDelete: Cascade)
  entryId    String   @unique @map("entry_id") @db.Uuid
  entry      QueueEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  orderNumber      String            @map("order_number")
  stage            KitchenOrderStage @default(INCOMING)
  preparationMinutes Int?            @map("preparation_minutes")
  startedAt        DateTime?         @map("started_at")
  readyAt          DateTime?         @map("ready_at")
  collectedAt      DateTime?         @map("collected_at")
  assignedWaiterId String?           @map("assigned_waiter_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([businessId, branchId, stage])
  @@index([queueId, stage])
  @@map("kitchen_orders")
}

// =============================================================================
// CUSTOMERS
// =============================================================================

/// A customer is scoped per-Business (not global): the same phone number
/// visiting two different businesses produces two Customer rows. There is
/// deliberately no password/login — see docs/DATABASE_DESIGN.md.
model Customer {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  fullName      String    @map("full_name")
  /// Uniqueness of (businessId, phone) enforced via partial unique index
  /// (see file header) so a soft-deleted customer's number can be reused.
  phone         String
  email         String?
  notes         String?
  totalVisits   Int       @default(0) @map("total_visits")
  lastVisitAt   DateTime? @map("last_visit_at")
  isBlacklisted Boolean   @default(false) @map("is_blacklisted")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  queueEntries  QueueEntry[]
  notifications Notification[]
  feedback      Feedback[]
  webPushSubscriptions WebPushSubscription[]

  @@index([businessId, phone])
  @@index([businessId, lastVisitAt])
  @@map("customers")
}

// =============================================================================
// NOTIFICATIONS
// =============================================================================

/// One intended message. Decoupled from delivery attempts (NotificationLog)
/// so retries/provider-status webhooks don't mutate identity — only the
/// denormalized `status` on this row does.
model Notification {
  id           String      @id @default(uuid()) @db.Uuid
  businessId   String      @map("business_id") @db.Uuid
  business     Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId   String      @map("customer_id") @db.Uuid
  customer     Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// NULL for business-initiated broadcasts not tied to a specific visit.
  queueEntryId String?     @map("queue_entry_id") @db.Uuid
  queueEntry   QueueEntry? @relation(fields: [queueEntryId], references: [id], onDelete: SetNull)

  channel     NotificationChannel
  type        NotificationType
  /// Template variables used to render the message, e.g. { "position": 3,
  /// "etaMinutes": 12 }. Kept as JSON rather than a fixed column set since
  /// each NotificationType needs different variables.
  payload     Json?
  status      NotificationStatus  @default(PENDING)
  scheduledAt DateTime?           @map("scheduled_at")
  /// Deterministic key preventing duplicate notification intents.
  idempotencyKey String @unique @map("idempotency_key")
  /// Optional domain event correlation key for observability.
  eventKey       String? @map("event_key")
  /// Set when a worker claims delivery (PROCESSING); used for stale reclaim.
  processingStartedAt DateTime? @map("processing_started_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  logs NotificationLog[]
  job  NotificationJob?

  // Dispatch worker polling for due sends:
  @@index([status, scheduledAt])
  // Customer-facing notification history:
  @@index([customerId, status])
  @@index([queueEntryId])
  @@map("notifications")
}

/// PostgreSQL-backed delivery queue (NOTIFICATION_QUEUE_DRIVER=postgres).
/// Claimed with FOR UPDATE SKIP LOCKED for concurrent workers.
model NotificationJob {
  id             String               @id @default(uuid()) @db.Uuid
  notificationId String               @unique @map("notification_id") @db.Uuid
  notification   Notification         @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  status      NotificationJobStatus @default(PENDING)
  attempts    Int                   @default(0)
  maxAttempts Int                   @map("max_attempts")
  availableAt DateTime              @default(now()) @map("available_at")
  lockedAt    DateTime?             @map("locked_at")
  lockedBy    String?               @map("locked_by")
  lastError   String?               @map("last_error") @db.Text
  processedAt DateTime?             @map("processed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, availableAt])
  @@index([lockedAt])
  @@map("notification_jobs")
}

/// One delivery attempt / provider webhook update for a Notification.
/// Immutable append-only log — see file header exceptions.
model NotificationLog {
  id             String       @id @default(uuid()) @db.Uuid
  notificationId String       @map("notification_id") @db.Uuid
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  attemptNumber     Int                   @map("attempt_number")
  provider          NotificationProvider
  status            NotificationLogStatus
  /// Provider's own message id, used to correlate inbound delivery
  /// webhooks back to this attempt.
  providerMessageId String?               @map("provider_message_id")
  errorCode         String?               @map("error_code")
  errorMessage      String?               @map("error_message")
  requestPayload    Json?                 @map("request_payload")
  responsePayload   Json?                 @map("response_payload")
  sentAt            DateTime?             @map("sent_at")
  deliveredAt       DateTime?             @map("delivered_at")
  failedAt          DateTime?             @map("failed_at")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  @@index([notificationId])
  @@index([providerMessageId])
  @@map("notification_logs")
}

/// Per-business, per-type message templates with variable placeholders.
model NotificationTemplate {
  id         String               @id @default(uuid()) @db.Uuid
  businessId String               @map("business_id") @db.Uuid
  business   Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)

  type    NotificationType
  /// NULL = applies to all channels for this type/locale.
  channel NotificationChannel?
  locale  String               @default("en")
  /// Optional subject line (email / some SMS gateways).
  subject String?
  /// Body with `{{variable}}` placeholders.
  body    String
  isActive Boolean             @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@unique([businessId, type, channel, locale])
  @@index([businessId, type, isActive])
  @@map("notification_templates")
}

// =============================================================================
// FEEDBACK
// =============================================================================

model Feedback {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId   String   @map("branch_id") @db.Uuid
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  queueEntryId String     @unique @map("queue_entry_id") @db.Uuid
  queueEntry   QueueEntry @relation(fields: [queueEntryId], references: [id], onDelete: Cascade)

  status      FeedbackStatus @default(REQUESTED)
  /// 1-5. Nullable until actually submitted.
  rating      Int?
  comment     String?
  requestedAt DateTime       @default(now()) @map("requested_at")
  submittedAt DateTime?      @map("submitted_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  @@index([branchId, submittedAt])
  @@index([businessId, rating])
  @@map("feedback")
}

// =============================================================================
// BILLING
// =============================================================================

/// Platform-level catalog — NOT tenant-scoped. `isActive` (not deletedAt)
/// controls whether a plan is currently sellable, since historical
/// Subscriptions must keep referencing retired plans (see onDelete:
/// Restrict below) — deletedAt still exists for a true catalog cleanup
/// once no Subscription references the plan at all.
model SubscriptionPlan {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique
  slug String @unique

  priceMonthly             Decimal @map("price_monthly") @db.Decimal(10, 2)
  priceYearly              Decimal @map("price_yearly") @db.Decimal(10, 2)
  currency                 String  @default("USD")
  maxBranches              Int?    @map("max_branches")
  maxStaff                 Int?    @map("max_staff")
  maxQueuesPerBranch       Int?    @map("max_queues_per_branch")
  maxActiveEntriesPerQueue Int?    @map("max_active_entries_per_queue")
  /// Free-form feature flags, e.g. { "customBranding": true,
  /// "whatsappNotifications": true }. Kept as JSON so new plan tiers don't
  /// need a migration for every new feature flag.
  featureFlags             Json    @default("{}") @map("feature_flags")
  isActive                 Boolean @default(true) @map("is_active")
  sortOrder                Int     @default(0) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  subscriptions Subscription[]

  @@map("subscription_plans")
}

/// One Business can have several Subscription rows over time (upgrades,
/// downgrades, renewals) — history is preserved. The "current" one is
/// whichever has status IN (TRIALING, ACTIVE, PAST_DUE); a partial unique
/// index guarantees at most one such row per business (see file header
/// and docs/DATABASE_DESIGN.md "Why there's no Business.activeSubscriptionId
/// pointer") rather than a nullable FK from Business back to Subscription,
/// which would create a circular table dependency for no real benefit.
model Subscription {
  id         String           @id @default(uuid()) @db.Uuid
  businessId String           @map("business_id") @db.Uuid
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  planId     String           @map("plan_id") @db.Uuid
  plan       SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  status                 SubscriptionStatus @default(TRIALING)
  billingCycle           BillingCycle       @default(MONTHLY) @map("billing_cycle")
  currentPeriodStart     DateTime           @map("current_period_start")
  currentPeriodEnd       DateTime           @map("current_period_end")
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  trialEndsAt            DateTime?          @map("trial_ends_at")
  /// Payment-provider identifiers (e.g. Stripe), kept generic since the
  /// provider isn't chosen yet.
  externalCustomerId     String?            @map("external_customer_id")
  externalSubscriptionId String?            @map("external_subscription_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  @@index([businessId, status])
  @@index([planId])
  @@map("subscriptions")
}

// =============================================================================
// AUDIT LOG
// =============================================================================

/// Immutable, append-only. Never updated or deleted (see file header
/// exceptions) — this is the compliance/security trail. `businessId`/
/// `actorUserId` are SetNull on delete specifically so the log survives
/// even if the business or the acting user is later hard-deleted.
model AuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  businessId  String?   @map("business_id") @db.Uuid
  business    Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  actorUserId String?   @map("actor_user_id") @db.Uuid
  actorUser   User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  /// e.g. "queue.created", "staff.invited", "subscription.cancelled".
  action     String
  entityType String  @map("entity_type")
  entityId   String  @map("entity_id") @db.Uuid
  beforeData Json?   @map("before_data")
  afterData  Json?   @map("after_data")
  ipAddress  String? @map("ip_address")
  userAgent  String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([businessId, createdAt])
  @@index([entityType, entityId])
  @@index([actorUserId])
  @@map("audit_logs")
}

// =============================================================================
// PLATFORM ADMIN
// =============================================================================

/// Singleton platform configuration (feature flags, system settings).
model PlatformConfig {
  id           String   @id @default("default")
  featureFlags Json     @default("{}") @map("feature_flags")
  settings     Json     @default("{}")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("platform_config")
}

model SupportTicket {
  id         String                @id @default(uuid()) @db.Uuid
  businessId String?               @map("business_id") @db.Uuid
  business   Business?             @relation(fields: [businessId], references: [id], onDelete: SetNull)
  subject    String
  description String
  status     SupportTicketStatus   @default(OPEN)
  priority   SupportTicketPriority @default(MEDIUM)

  assignedToUserId String? @map("assigned_to_user_id") @db.Uuid
  assignedTo       User?   @relation("AssignedSupportTickets", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  createdByUserId    String? @map("created_by_user_id") @db.Uuid
  createdBy          User?   @relation("CreatedSupportTickets", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([businessId, status])
  @@index([assignedToUserId])
  @@map("support_tickets")
}

/// Browser Web Push subscription for a guest tracking an entry.
/// Scoped by entryId + endpoint so guests can re-subscribe after refresh.
model WebPushSubscription {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId String?  @map("customer_id") @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  queueEntryId String @map("queue_entry_id") @db.Uuid

  endpoint   String
  p256dh     String
  auth       String
  userAgent  String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([endpoint])
  @@index([queueEntryId])
  @@index([businessId, queueEntryId])
  @@map("web_push_subscriptions")
}
