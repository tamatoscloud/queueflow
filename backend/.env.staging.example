# Staging template. Copy to .env.staging for local staging runs.
# Real secrets are injected by CI/CD in deployed environments.
APP_ENV=staging
PORT=3000
API_BASE_PATH=/api
DATABASE_URL=CHANGE_ME_INJECTED_BY_CI
REDIS_URL=CHANGE_ME_INJECTED_BY_CI
JWT_SECRET=CHANGE_ME_INJECTED_BY_CI
JWT_EXPIRY_SECONDS=3600
REFRESH_TOKEN_SECRET=CHANGE_ME_INJECTED_BY_CI
FIREBASE_PROJECT_ID=queueflow-staging
SENTRY_DSN=CHANGE_ME_INJECTED_BY_CI
CORS_ALLOWED_ORIGINS=https://staging.queueflow.app
LOG_LEVEL=info
