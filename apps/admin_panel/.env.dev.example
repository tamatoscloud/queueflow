# Template — copy to .env.dev for local development.
APP_NAME=QueueFlow Admin (Dev)
# Android emulator: localhost is auto-rewritten to 10.0.2.2 at runtime.
# Physical device: replace localhost with your machine LAN IP in your local .env.dev.
