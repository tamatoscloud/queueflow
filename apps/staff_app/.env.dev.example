# Template — copy to .env.dev for local development.
# Android emulator: localhost is auto-rewritten to 10.0.2.2 at runtime.
# Physical device: replace localhost with your machine LAN IP in your local .env.dev.
APP_NAME=QueueFlow Staff (Dev)
API_BASE_URL=http://localhost:3000/api/v1
WS_BASE_URL=http://localhost:3000
ENABLE_LOGGING=true
API_TIMEOUT_SECONDS=30
SENTRY_DSN=
FIREBASE_PROJECT_ID=queueflow-dev
CUSTOMER_PORTAL_URL=http://localhost:3001
