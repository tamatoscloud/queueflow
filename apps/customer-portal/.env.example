# Customer Portal — environment template
# Copy to .env.local (gitignored) for local development.
#
# Phone testing: replace localhost with your PC's LAN IP (same Wi-Fi as phone).

# Backend API base URL (includes /api/v1)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# WebSocket server URL (defaults to API host without /api/v1)
# NEXT_PUBLIC_API_WS_URL=http://localhost:3000

# Optional: public site URL for QR codes (defaults to window.location.origin)
# NEXT_PUBLIC_SITE_URL=http://localhost:3001
