{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "bash ../../scripts/vercel-flutter-build.sh install",
  "buildCommand": "bash ../../scripts/vercel-flutter-build.sh build",
  "outputDirectory": "build/web",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ../../packages ../../scripts/vercel-flutter-build.sh",
  "headers": [
    {
      "source": "/canvaskit/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(index.html|flutter_bootstrap.js|flutter_service_worker.js|version.json)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
