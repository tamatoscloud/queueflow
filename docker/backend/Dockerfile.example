# Generic template — NOT wired up yet. Rename to `Dockerfile` once the
# backend framework (backend/README.md) is chosen and adjust the runtime
# stage accordingly (this assumes a Node.js LTS service as a placeholder).

# ---- deps -------------------------------------------------------------
FROM node:22-alpine AS deps
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev

# ---- build --------------------------------------------------------------
FROM node:22-alpine AS build
WORKDIR /app
COPY . .
RUN npm ci && npm run build

# ---- runtime ------------------------------------------------------------
FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup -S queueflow && adduser -S queueflow -G queueflow
COPY --from=deps /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
USER queueflow
EXPOSE 3000
# Real secrets are injected at deploy time by the orchestrator/CI secret
# manager — never baked into the image. See backend/ENV_SCHEMA.md.
CMD ["node", "dist/main.js"]
